/**
 This is a driver class for Property and ManagementCompany classes.
 It allows the user to choose from four options, and acts as the user requested.
 */
public class PropertyDriver {
	public static void main(String[] args) {
		//Declare objects used
		Scanner input = new Scanner(System.in);
		ManagementCompany managementCompany = new ManagementCompany("Montgomery College", "989-989-9090");
		Property property = new Property();
		//Declare the Strings to hold the menu and header as well as the variables used in the following do-while loop. Then print the header.
		int choice = 3, indexOfPropertyAdded;
		double monthlyRent;
		String propertyName, city, ownerName;
		String header = "=========================================\n       Assignment 4: Property Manager\n==========================================\n";
		String menu = "1-Add Property\n2-Display All Properties\n3-Show Total Rent\n4-Exit";
		System.out.print(header);
		do {
			//Print the menu, ask the choice, and validate it.
			System.out.print(menu+"\n\nEnter choice (1-4): ");
			choice = input.nextInt();
			
			while(choice <=0 || choice >=5) {
				System.out.print("Please re-enter: ");
				choice = input.nextInt();
			}
			//Read the remaining "\n" character
			input.nextLine();
			//Determine which of the four valid choices was chosen. If 4 was inputed, then the switch statement simply skips it and the loop ends.
			switch(choice) {
			case 1: //Add property choice. Lines 27-40 absorb and validate the information about a property
				System.out.print("Enter property name: ");
				propertyName = input.nextLine();
				System.out.print("Enter city: ");
				city = input.nextLine();
				System.out.print("Enter monthly rent: ");
				monthlyRent = input.nextDouble();
				input.nextLine();
				while(monthlyRent <=0) {
					System.out.print("Negative values and zero are not accepted. Please re-enter: ");
					monthlyRent = input.nextDouble();
					input.nextLine();
				}
				System.out.print("Enter owner name: ");
				ownerName = input.nextLine();
				property.setPropertyName(propertyName);
				property.setCity(city);
				property.setOwner(ownerName);
				property.setRentAmount(monthlyRent);
				//The following line attemps to add the property. The index (or error code) returned is assigned to indexOfPropertyAdded variable.
				indexOfPropertyAdded = managementCompany.addProperty(property);
				//If the error code was returned, print the error message. Otherwise, print "Property added at index: " and index.
				if(indexOfPropertyAdded == -1) {
					System.out.println("Property can't be added as the property list is already full.");
				}
				else {
					System.out.println("Property added at index: " + indexOfPropertyAdded + ".");
				}
				break;
			case 2:
				//Display information. The following print statement calls manageCompany's toString() 
				//and displays the information about the company and it's properties
				System.out.print(managementCompany);
				break;
			case 3://Show total rent.
				System.out.println("Total rent: $" + managementCompany.totalRent());
				break;
			}
			//Just a new line so that the output would be more readable.
			System.out.println();
		} while(choice !=4);
		//End of the program.
		System.out.print("Thank you! Bye!\nProgrammer: Alexander Zlodorev");
		input.close();
		System.exit(0);
	}

}
/**
 This is a class that stores information about Management Company.
 */
public class ManagementCompany {
	public static final int MAX_PROPERTIES = 3;
	private String name, taxId;
	private Property[] properties = new Property[MAX_PROPERTIES];
	private static int propertyCount=0;
	/**
	 No-arg constructor
	 */
	public ManagementCompany() {
		this("White Wash Company, Inc.","345-345-6767");
		propertyCount =0;
	}
	/**
	 Constructor initializes name and taxId with the passed arguments. 
	 @param name Name of the company
	 @param taxId Tax ID of the company
	 */
	public ManagementCompany(String name, String taxId){
		this.name = name;
		this.taxId = taxId;
		propertyCount =0;
	}
	/**
	 Copy constructor
	 @param mgP The ManagementCompany object to be copied.
	 */
	public ManagementCompany(ManagementCompany mgP) {
		name = mgP.name;
		taxId = mgP.taxId;
		for(int index =0; index<properties.length&&mgP.properties[index] != null; index++) {
			properties[index] = new Property(mgP.properties[index]);
		}
		propertyCount =1;
	}
	/**
	 This method adds a property to Property[] properties using Property class's copy constructor. 
	 If the array is full, the method returns an error code.
	 @param p The Property object to be added
	 @return propertyCount-1 The index of the added property.
	 */
	public int addProperty(Property p) {
		
		if(propertyCount == properties.length) {
			return -1;
		}

		properties[propertyCount] = new Property(p);
		propertyCount++;
		return (propertyCount-1);
	}
	/**
	  This method calculates and returns the totalRent of properties inside properties array.
	 @return totalRent Sum of each property's rent amount.
	 */
	public double totalRent() {
		double totalRent =0;
		for(int index =0; index< properties.length&&properties[index]!=null; index++) {
			totalRent += properties[index].getRentAmount();
		}
		return totalRent;
	}
	
	/**
	 This methods formats and returns the information about the company and its' properties.
	 @return info All the information about the company and its' properties.
	 */
	public String toString() {
		String info = "Management company: " + name  + " (Tax ID:" + taxId+")\nProperties:\n";
		if(properties[0] == null) {
			info += " No properties owned\n";
		}
		for(int index=0; index<properties.length&&properties[index] !=null; index++) {
			info += " "+ index + ": " + properties[index]+"\n";
		}
		info +="Total rent: $" + String.format("%.2f",totalRent())+"\n";
		return info;
	}
	/**
	Returns the property count. 
	 @return propertyCount The field counting the number of properties.
	 */
	public int getPropertyCount() {
		return propertyCount;
	}
	/**
	 This method returns the name of the company. 
	 @return name Name of the company
	 */
	public String getName() {
		return name;
	}
	/**
	 This method returns the tax ID of the company. 
	 @return taxId Tax ID of the company
	 */
	public String getTaxId() {
		return taxId;
	}
}
/**
 This class contains all the information about a company's property.
 */
public class Property {
	private String propertyName, owner, city;
	private double rentAmount;
	/**
	 No-arg constructor
	 */
	public Property() {
		propertyName = "Property 1";
		city = "Cleveland";
		owner = "Alexander Hamilton";
		rentAmount = 900.0;
	}
	/**
	 This constructor initializes all the fields with the arguments passed. 
	 @param propertyName property name
	 @param city city
	 @param rentAmount rent amount
	 @param owner Owner of the property
	 */
	public Property(String propertyName, String city, double rentAmount, String owner) {
		this.propertyName= propertyName;
		this.city = city;
		this.rentAmount = rentAmount;
		this.owner = owner;
	}
	/**
	 Copy constructor. 
	 @param anotherProperty The Property object to be copied.
	 */
	public Property(Property anotherProperty) {
		propertyName = anotherProperty.propertyName;
		owner = anotherProperty.owner;
		city = anotherProperty.city;
		rentAmount = anotherProperty.rentAmount;
	}
	/**
	 Returns the property's name. 
	 @return propertyName Property's name
	 */
	public String getPropertyName() {
		return propertyName;
	}
	/**
	 Sets the property's name to the argument passed. 
	 @param propertyName property's name
	 */
	public void setPropertyName(String propertyName) {
		this.propertyName = propertyName;
	}
	/**
	 Returns the property's owner. 
	 @return owner Property's owner
	 */
	public String getOwner() {
		return owner;
	}
	/**
	 Sets the property's owner to the argument passed. 
	 @param owner Owner of the property.
	 */
	public void setOwner(String owner) {
		this.owner = owner;
	}
	/**
	 Returns the property's city. 
	 @return city Property's city
	 */
	public String getCity() {
		return city;
	}
	/**
	 Sets the property's city to the argument passed. 
	 @param city property's city
	 */
	public void setCity(String city) {
		this.city = city;
	}
	/**
	 Returns the property's rent amount. 
	 @return rentAmount Property's rent amount
	 */
	public double getRentAmount() {
		return rentAmount;
	}
	/**
	 Sets the property's rentAmount to the argument passed. 
	 @param rentAmount property's rent amount
	 */
	public void setRentAmount(double rentAmount) {
		this.rentAmount = rentAmount>0?rentAmount: 0;
	}
	/**
	 This method returns the String representation of the object.
	 @return info Information about the property.
	 */
	public String toString() {
		return propertyName + ", "+ city+", Rent: $" + String.format("%.2f", rentAmount) + ", Owner: " + owner;
	}
}
